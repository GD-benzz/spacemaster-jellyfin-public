[Unit]
Description=SpaceMaster profile-proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sm
User=root
Environment=UPSTREAM=http://127.0.0.1:8096
Environment=LISTEN_PORT=8097
Environment=STRIP_AUDIO=aac,aac_latm,mp3
Environment=ENABLE=true
Environment=PEQ_FILE=/opt/sm/peq_af.txt
Environment=PROXY_LOG=/opt/sm/proxy.log
ExecStart=/usr/bin/python3 /opt/sm/profile-proxy.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
